---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { site, centrelink } from '../../data/datos.js';

export function getStaticPaths() {
  return centrelink.map(c => ({ params: { slug: c.slug } }));
}

const { slug } = Astro.params;
const centre = centrelink.find(c => c.slug === slug);

if (!centre) {
  throw new Error(`No centre found for slug: ${slug}`);
}

// Build address parts
const addressParts = [centre.address1, `${centre.suburb} ${centre.state} ${centre.postcode}`, 'Australia'].filter(Boolean);
const fullAddress = addressParts.join(', ');
const shortAddress = `${centre.suburb}, ${centre.state} ${centre.postcode}`;

// Google Maps embed URL (no API key needed)
const mapEmbedUrl = `https://maps.google.com/maps?q=${centre.latitude},${centre.longitude}&hl=en&z=15&output=embed`;
const mapsLinkUrl = `https://www.google.com/maps/search/?api=1&query=${centre.latitude},${centre.longitude}`;
const directionsUrl = `https://www.google.com/maps/dir/?api=1&destination=${centre.latitude},${centre.longitude}`;

// "Today" is worked out in the visitor's browser (this is a static site)
const timeZones = { NSW: 'Australia/Sydney', ACT: 'Australia/Sydney', VIC: 'Australia/Melbourne', TAS: 'Australia/Hobart', QLD: 'Australia/Brisbane', SA: 'Australia/Adelaide', NT: 'Australia/Darwin', WA: 'Australia/Perth' };

// Schema: GovernmentOffice with full address, hours, geo
const openingHoursSpec = centre.hours
  .filter(h => h.open && h.close)
  .map(h => ({
    "@type": "OpeningHoursSpecification",
    dayOfWeek: `https://schema.org/${h.day}`,
    opens: h.open,
    closes: h.close
  }));

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id": `https://${site.domain}/centrelink/${centre.slug}/`,
      "url": `https://${site.domain}/centrelink/${centre.slug}/`,
      "name": `${centre.name} — Address, Hours, Phone, Services`,
      "description": `${centre.name} at ${shortAddress}. Opening hours, services available, contact details, and how to get there.`,
      "inLanguage": "en-AU"
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        {"@type": "ListItem", "position": 1, "name": "Home", "item": `https://${site.domain}/`},
        {"@type": "ListItem", "position": 2, "name": centre.state_full, "item": `https://${site.domain}/state/${centre.state_full.toLowerCase().replace(/\s+/g, '-')}/`},
        {"@type": "ListItem", "position": 3, "name": centre.name}
      ]
    },
    {
      "@type": "GovernmentOffice",
      "name": centre.name,
      "description": `${centre.status_chip} service centre serving ${centre.suburb}, ${centre.state_full} and surrounding areas.`,
      "url": `https://${site.domain}/centrelink/${centre.slug}/`,
      "telephone": site.centrelink_phone_intl,
      "address": {
        "@type": "PostalAddress",
        ...(centre.address1 ? {"streetAddress": centre.address1} : {}),
        "addressLocality": centre.suburb,
        "addressRegion": centre.state,
        "postalCode": centre.postcode,
        "addressCountry": "AU"
      },
      "geo": {
        "@type": "GeoCoordinates",
        "latitude": centre.latitude,
        "longitude": centre.longitude
      },
      "openingHoursSpecification": openingHoursSpec,
      "hasMap": mapsLinkUrl,
      "parentOrganization": {
        "@type": "GovernmentOrganization",
        "name": "Services Australia",
        "url": "https://www.servicesaustralia.gov.au"
      }
    }
  ]
};

const stateSlug = centre.state_full.toLowerCase().replace(/\s+/g, '-');

// Nearest centres by real distance (any state: border towns matter)
const toRad = (d) => d * Math.PI / 180;
const distanceKm = (a, b) => {
  const dLat = toRad(b.latitude - a.latitude);
  const dLon = toRad(b.longitude - a.longitude);
  const h = Math.sin(dLat / 2) ** 2 + Math.cos(toRad(a.latitude)) * Math.cos(toRad(b.latitude)) * Math.sin(dLon / 2) ** 2;
  return 6371 * 2 * Math.asin(Math.sqrt(h));
};
const nearby = centrelink
  .filter(c => c.slug !== centre.slug)
  .map(c => ({ ...c, km: distanceKm(centre, c) }))
  .sort((a, b) => a.km - b.km)
  .slice(0, 6);

const centrelinkTasks = [
  { href: '/services/jobseeker-payment/', icon: 'fa-briefcase', title: 'JobSeeker Payment', text: 'Out of work: who can claim and how' },
  { href: '/services/age-pension-application/', icon: 'fa-person-cane', title: 'Age Pension', text: 'Eligibility and how to apply' },
  { href: '/services/disability-support-pension/', icon: 'fa-wheelchair', title: 'Disability Support Pension', text: 'Requirements and the claim process' },
  { href: '/services/family-tax-benefit/', icon: 'fa-people-roof', title: 'Family Tax Benefit', text: 'Part A and Part B explained' },
  { href: '/services/parenting-payment/', icon: 'fa-children', title: 'Parenting Payment', text: 'For parents and carers' },
  { href: '/services/youth-allowance/', icon: 'fa-graduation-cap', title: 'Youth Allowance', text: 'Students and young job seekers' },
  { href: '/services/carer-payment/', icon: 'fa-hand-holding-heart', title: 'Carer Payment', text: 'If you care for someone full time' },
];
const medicareTasks = [
  { href: '/services/medicare-card-replacement/', icon: 'fa-id-card', title: 'Replace a Medicare card', text: 'Lost, stolen or damaged card' },
];
const tasks = [
  ...(centre.services.includes('Centrelink') ? centrelinkTasks : []),
  ...(centre.services.includes('Medicare') ? medicareTasks : []),
];
---

<Base
  title={`${centre.name} — Address, Hours, Phone | Centrelink ${centre.suburb} ${centre.state}`}
  description={`${centre.name} at ${shortAddress}. Opening hours, contact details, services, map and directions. Services: ${centre.status_chip}.`}
  canonicalPath={`/centrelink/${centre.slug}/`}
  schema={schema}
>
  <Breadcrumbs items={[
    {label: 'Home', href: '/'},
    {label: centre.state_full, href: `/state/${stateSlug}/`},
    {label: centre.name}
  ]} />

  <article class="page">
    <header class="page-header">
      <p class="eyebrow eyebrow-location">Service Centre · {centre.state_full}</p>
      <h1>{centre.name}</h1>
      <p class="status-chip">{centre.status_chip}<span id="today-label"></span></p>
      <p class="intro hero-intro">
        <strong>{centre.name}</strong> is {centre.address1 ? <>at <strong>{centre.address1}, {shortAddress}</strong></> : <>in <strong>{centre.suburb}, {centre.state_full}</strong> ({centre.postcode})</>}. This Services Australia office handles <strong>{centre.status_chip}</strong> services for residents of {centre.suburb} and surrounding suburbs. Call Centrelink on <a href={`tel:${site.centrelink_phone.replace(/\s+/g, '')}`}><strong>{site.centrelink_phone}</strong></a>.
        {!centre.address1 && (
          <span> The exact street address is best verified via the map below or by phone.</span>
        )}
      </p>
      <div class="cta-row">
        <a href="/guides/how-to-book-centrelink-appointment/" class="btn-primary">
          <i class="fas fa-calendar-check"></i> Book an appointment
        </a>
        <a href="/guides/what-to-bring-to-centrelink/" class="btn-ghost">
          <i class="fas fa-list-check"></i> What to bring
        </a>
        <a href="/guides/centrelink-call-wait-times/" class="btn-ghost">
          <i class="fas fa-clock"></i> Call wait times
        </a>
        <a href="/guides/services-australia-online-vs-in-person/" class="btn-ghost">
          <i class="fas fa-laptop"></i> Do it online?
        </a>
      </div>
    </header>

    <div class="article-grid-v2">
      <div class="article-main">
        <div class="map-embed">
          <iframe
            src={mapEmbedUrl}
            width="100%"
            height="380"
            style="border:0; border-radius: 8px;"
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            title={`Map of ${centre.name}`}
          />
          <p class="map-note">
            <i class="fas fa-location-dot"></i> {centre.address1 ? <><strong>{centre.address1}</strong>, </> : ''}{shortAddress}, Australia · Coordinates: <code>{centre.latitude.toFixed(4)}, {centre.longitude.toFixed(4)}</code>
          </p>
          <div class="map-actions">
            <a href={directionsUrl} class="btn-ghost" target="_blank" rel="noopener"><i class="fas fa-route"></i> Get directions</a>
            <a href={mapsLinkUrl} class="btn-ghost" target="_blank" rel="noopener"><i class="fas fa-map-location-dot"></i> Open in Maps</a>
          </div>
        </div>

        <h2 id="opening-hours">Opening hours</h2>
        <table class="hours-table" data-hours data-tz={timeZones[centre.state]}>
          <thead>
            <tr><th>Day</th><th>Opening hours</th></tr>
          </thead>
          <tbody>
            {centre.hours.map(h => (
              <tr data-day={h.day} data-open={h.open && h.close ? h.open : undefined} data-close={h.open && h.close ? h.close : undefined}>
                <td><strong>{h.day}</strong></td>
                <td>
                  {h.open && h.close ? (
                    <>
                      {h.open} – {h.close}
                      {h.break_start && h.break_close && (
                        <span class="break-note"> (closed for break {h.break_start}–{h.break_close})</span>
                      )}
                    </>
                  ) : <span class="closed">Closed</span>}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
        <p class="hours-note"><i class="fas fa-circle-info"></i> Hours based on Services Australia's published office location data, last checked November 2026. Always call before visiting to confirm — public holidays may affect opening hours.</p>

        <h2 id="services">Services available at this centre</h2>
        <p>{centre.name} provides the following services:</p>
        <ul class="service-list">
          {centre.services.includes('Centrelink') && (
            <li>
              <strong>Centrelink services</strong> — JobSeeker, Age Pension, Disability Support Pension, Youth Allowance, Family Tax Benefit, Parenting Payment, Carer Payment, and more. <a href="/services/centrelink-payments/">See all Centrelink payments</a>.
            </li>
          )}
          {centre.services.includes('Medicare') && (
            <li>
              <strong>Medicare services</strong> — enrolment, Medicare card replacement, claims, and family health cover. <a href="/services/medicare-services/">Learn about Medicare services</a>.
            </li>
          )}
          {centre.services.includes('Veterans Affairs') && (
            <li>
              <strong>Veterans Information Service</strong> — DVA support, pensions, and entitlements for current and former Australian Defence Force members.
            </li>
          )}
          {centre.services.includes('NDIS') && (
            <li>
              <strong>NDIS (National Disability Insurance Scheme)</strong> — registration, plan management, and access to disability support services.
            </li>
          )}
        </ul>

        <h3 class="cards-title">What do you need to do?</h3>
        <div class="task-grid">
          {tasks.map(t => (
            <a href={t.href} class="task-card">
              <i class={`fas ${t.icon}`}></i>
              <span><strong>{t.title}</strong><small>{t.text}</small></span>
              <i class="fas fa-arrow-right task-arrow"></i>
            </a>
          ))}
        </div>

        <h2 id="how-to-prepare">How to prepare for your visit</h2>
        <p>Before visiting <strong>{centre.name}</strong>, prepare the following:</p>
        <ul class="checklist">
          <li><strong>Photo ID</strong> — driver licence, passport, or Australian birth certificate.</li>
          <li><strong>myGov account</strong> — if you have one, link Centrelink/Medicare beforehand at <a href="https://my.gov.au" rel="noopener">my.gov.au</a> to speed things up.</li>
          <li><strong>Bank details</strong> — BSB and account number if applying for or updating payments.</li>
          <li><strong>Proof of address</strong> — recent utility bill or bank statement.</li>
          <li><strong>Income or evidence documents</strong> — relevant to the claim you're making (payslips, medical certificates, custody papers, etc.).</li>
          <li><strong>Interpreter request</strong> — if needed, call <a href={`tel:131450`}>131 450</a> (TIS National) before your visit to arrange one for free.</li>
        </ul>
        <p>For a full step-by-step before-you-visit checklist, see <a href="/guides/what-to-bring-to-centrelink/">what to bring to Centrelink</a>.</p>

        <h2 id="booking">Booking an appointment</h2>
        <p>
          Many Centrelink services can be done online via <a href="https://my.gov.au" rel="noopener">myGov</a>. For services that need an in-person visit, you can book an appointment by calling <a href={`tel:${site.centrelink_phone.replace(/\s+/g, '')}`}><strong>{site.centrelink_phone}</strong></a> (Centrelink general line) or visiting the centre during opening hours. Walk-in service is available, but waits vary with the time of day, so booking is the safer option.
        </p>
        <p>
          For step-by-step instructions, see <a href="/guides/how-to-book-centrelink-appointment/">how to book a Centrelink appointment</a>.
        </p>

        <h2 id="nearby">Centrelink offices near {centre.suburb}</h2>
        <div class="near-grid">
          {nearby.map(n => (
            <a href={`/centrelink/${n.slug}/`} class="near-card">
              <span><strong>{n.name}</strong><small>{n.suburb}, {n.state} {n.postcode}</small></span>
              <b>{n.km < 10 ? n.km.toFixed(1) : Math.round(n.km)} km</b>
            </a>
          ))}
        </div>
        <p class="hours-note">Straight-line distance from this centre. <a href={`/state/${stateSlug}/`}>See all {centre.state_full} centres</a>.</p>

        <h2 id="faq">Frequently asked questions</h2>
        <details class="faq-item">
          <summary>What's the wait time at {centre.name}?</summary>
          <p>Wait times vary by time of day and time of month, and Services Australia does not publish them per centre. Call <a href={`tel:${site.centrelink_phone.replace(/\s+/g, '')}`}>{site.centrelink_phone}</a> to ask about current wait times or to book an appointment.</p>
        </details>
        <details class="faq-item">
          <summary>Can I do my Centrelink business online instead?</summary>
          <p>Yes. Most Centrelink and Medicare services are available via <a href="https://my.gov.au" rel="noopener">myGov</a> — claims, payment history, updating details, uploading documents, and reporting income. In-person visits are usually only needed for identity verification, document originals, or complex situations. See <a href="/guides/services-australia-online-vs-in-person/">services online vs. in person</a>.</p>
        </details>
        <details class="faq-item">
          <summary>Is the {centre.suburb} office accessible?</summary>
          <p>Most Services Australia centres have wheelchair access, hearing loops, and provide interpreter services on request (call <a href="tel:131450">131 450</a>). Specific accessibility features for {centre.name} can be confirmed by calling <a href={`tel:${site.centrelink_phone.replace(/\s+/g, '')}`}>{site.centrelink_phone}</a> before your visit.</p>
        </details>
        <details class="faq-item">
          <summary>What's the difference between Centrelink and Medicare here?</summary>
          <p>{centre.name} is a combined service centre. <strong>Centrelink</strong> handles welfare and income support payments (JobSeeker, Age Pension, family payments, etc.). <strong>Medicare</strong> handles health-related services (Medicare card, claims for medical visits, vaccination records). Both can usually be done at the same centre in one visit.</p>
        </details>
      </div>

      <aside class="sidebar-stack">
        <div class="quick-info-card">
          <h3>At a glance</h3>
          <dl>
            <dt>Address</dt>
            <dd>{centre.address1 || `${centre.suburb}, ${centre.state}`}<br />{shortAddress}, Australia</dd>
            <dt>Coordinates</dt>
            <dd><code>{centre.latitude.toFixed(4)}, {centre.longitude.toFixed(4)}</code></dd>
            <dt>State</dt>
            <dd>{centre.state_full}</dd>
            <dt>Postcode</dt>
            <dd>{centre.postcode}</dd>
            <dt>Services</dt>
            <dd>{centre.status_chip}</dd>
            <dt>Centrelink phone</dt>
            <dd><a href={`tel:${site.centrelink_phone.replace(/\s+/g, '')}`}>{site.centrelink_phone}</a></dd>
            {centre.services.includes('Medicare') && (
              <>
                <dt>Medicare phone</dt>
                <dd><a href={`tel:${site.medicare_phone.replace(/\s+/g, '')}`}>{site.medicare_phone}</a></dd>
              </>
            )}
          </dl>
          <a href={`tel:${site.centrelink_phone.replace(/\s+/g, '')}`} class="btn-primary btn-block">
            <i class="fas fa-phone"></i> Call now
          </a>
        </div>

        <div class="related-card">
          <h3>Before you go</h3>
          <ul>
            <li><a href="/guides/what-to-bring-to-centrelink/">What to bring to Centrelink <i class="fas fa-arrow-right"></i></a></li>
            <li><a href="/guides/how-to-book-centrelink-appointment/">How to book an appointment <i class="fas fa-arrow-right"></i></a></li>
            <li><a href="/guides/centrelink-call-wait-times/">Best times to call <i class="fas fa-arrow-right"></i></a></li>
            <li><a href="/guides/services-australia-online-vs-in-person/">Online vs in person <i class="fas fa-arrow-right"></i></a></li>
            <li><a href="/services/centrelink-payments/">All Centrelink payments <i class="fas fa-arrow-right"></i></a></li>
            <li><a href="/services/medicare-services/">Medicare services <i class="fas fa-arrow-right"></i></a></li>
          </ul>
        </div>
      </aside>
    </div>
  </article>
  <script is:inline>
  (function(){
    var t=document.querySelector('[data-hours]');if(!t)return;
    var day;try{day=new Intl.DateTimeFormat('en-AU',{weekday:'long',timeZone:t.dataset.tz}).format(new Date())}catch(e){return}
    var row=t.querySelector('tr[data-day="'+day+'"]');if(!row)return;
    row.classList.add('today');
    var tag=document.createElement('span');tag.className='today-tag';tag.textContent=' · Today';row.querySelector('td').appendChild(tag);
    var l=document.getElementById('today-label');
    if(l)l.textContent=' · '+(row.dataset.open?'Open today '+row.dataset.open+'–'+row.dataset.close:'Closed today');
  })();
  </script>
</Base>

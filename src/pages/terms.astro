---
// generado por herramientas-investigacion/legales
import L from '../data/legal.json';
import LS from '../data/contacto.json';
import Base from '../layouts/Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { site } from '../data/datos.js';

const schema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "url": `https://${site.domain}/terms/`,
  "name": "Terms of use"
};
---

<Base title={`Terms of use — ${site.name}`} description="Terms of use of Centrelink Offices Australia, an independent, unofficial site about Centrelink service centres in Australia." canonicalPath="/terms/" schema={schema}>
  <Breadcrumbs ld items={[{label: 'Home', href: '/'}, {label: 'Terms'}]} />

  <article class="page page-narrow">
    <header class="page-header">
      <p class="eyebrow">Terms</p>
      <h1>Terms of use</h1>
    </header>

    <div class="article-main-narrow">
<Fragment set:html={L['terms'].html.replaceAll('{{EMAIL}}', LS.email)} />
    </div>
  </article>
</Base>

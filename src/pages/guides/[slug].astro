---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { site, guides } from '../../data/datos.js';

export function getStaticPaths() {
  return guides.map(g => ({ params: { slug: g.slug } }));
}

const { slug } = Astro.params;
const guide = guides.find(g => g.slug === slug);
if (!guide) throw new Error(`No guide: ${slug}`);

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id": `https://${site.domain}/guides/${guide.slug}/`,
      "url": `https://${site.domain}/guides/${guide.slug}/`,
      "name": guide.title,
      "description": guide.meta,
      "inLanguage": "en-AU"
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        {"@type": "ListItem", "position": 1, "name": "Home", "item": `https://${site.domain}/`},
        {"@type": "ListItem", "position": 2, "name": "Guides", "item": `https://${site.domain}/guides/`},
        {"@type": "ListItem", "position": 3, "name": guide.h1}
      ]
    },
    {
      "@type": "HowTo",
      "name": guide.h1,
      "description": guide.meta,
      "step": guide.sections.map((s, i) => ({
        "@type": "HowToStep",
        "position": i + 1,
        "name": s.heading
      }))
    },
    ...(guide.faqs && guide.faqs.length > 0 ? [{
      "@type": "FAQPage",
      "mainEntity": guide.faqs.map(f => ({
        "@type": "Question",
        "name": f.q,
        "acceptedAnswer": {"@type": "Answer", "text": f.a}
      }))
    }] : [])
  ]
};

const related = guides.filter(g => g.slug !== guide.slug);
---

<Base
  title={guide.title}
  description={guide.meta}
  canonicalPath={`/guides/${guide.slug}/`}
  schema={schema}
>
  <Breadcrumbs items={[
    {label: 'Home', href: '/'},
    {label: 'Guides', href: '/guides/'},
    {label: guide.h1}
  ]} />

  <article class="page">
    <header class="page-header">
      <p class="eyebrow eyebrow-guide">{guide.category}</p>
      <h1>{guide.h1}</h1>
      <p class="status-chip">{guide.status_chip}</p>
      <div class="cta-row">
        <a href={`tel:${site.centrelink_phone.replace(/\s+/g, '')}`} class="btn-primary">
          <i class="fas fa-phone"></i> Call Centrelink {site.centrelink_phone}
        </a>
        <a href="https://my.gov.au" class="btn-ghost" rel="noopener">
          <i class="fas fa-arrow-up-right-from-square"></i> myGov
        </a>
      </div>
    </header>

    <div class="article-grid-v2">
      <div class="article-main">
        <p class="intro" set:html={guide.intro}></p>

        {guide.sections.map(section => (
          <>
            <h2 id={section.heading.toLowerCase().replace(/[^a-z0-9]+/g, '-')}>{section.heading}</h2>
            {Array.isArray(section.body) ? (
              <ul>
                {section.body.map(b => <li set:html={b}></li>)}
              </ul>
            ) : (
              <p set:html={section.body}></p>
            )}
          </>
        ))}

        {guide.faqs && guide.faqs.length > 0 && (
          <>
            <h2 id="faq">Frequently asked questions</h2>
            {guide.faqs.map(f => (
              <details class="faq-item">
                <summary>{f.q}</summary>
                <p set:html={f.a}></p>
              </details>
            ))}
          </>
        )}
      </div>

      <aside class="sidebar-stack">
        <div class="quick-info-card">
          <h3>Quick reference</h3>
          <dl>
            <dt>Topic</dt>
            <dd>{guide.category}</dd>
            <dt>Centrelink</dt>
            <dd><a href={`tel:${site.centrelink_phone.replace(/\s+/g, '')}`}>{site.centrelink_phone}</a></dd>
            <dt>myGov</dt>
            <dd><a href="https://my.gov.au" rel="noopener">my.gov.au</a></dd>
            <dt>Interpreter</dt>
            <dd><a href="tel:131450">131 450</a> (free)</dd>
          </dl>
        </div>

        <div class="related-card">
          <h3>Other guides</h3>
          <ul>
            {related.map(r => (
              <li>
                <a href={`/guides/${r.slug}/`}>
                  {r.h1}
                  <i class="fas fa-arrow-right"></i>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </aside>
    </div>
  </article>
</Base>

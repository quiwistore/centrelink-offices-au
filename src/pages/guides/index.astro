---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { site, guides } from '../../data/datos.js';

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {"@type": "WebPage", "@id": `https://${site.domain}/guides/`, "url": `https://${site.domain}/guides/`, "name": "Centrelink & Services Australia — Practical Guides", "description": "How-to guides for dealing with Centrelink and Services Australia.", "inLanguage": "en-AU"},
    {"@type": "BreadcrumbList", "itemListElement": [
      {"@type": "ListItem", "position": 1, "name": "Home", "item": `https://${site.domain}/`},
      {"@type": "ListItem", "position": 2, "name": "Guides"}
    ]},
    {"@type": "ItemList", "name": "Practical guides", "numberOfItems": guides.length, "itemListElement": guides.map((g, i) => ({"@type": "ListItem", "position": i + 1, "url": `https://${site.domain}/guides/${g.slug}/`, "name": g.h1}))}
  ]
};
---

<Base title="Centrelink Practical Guides — How to Book, What to Bring, Wait Times" description="Practical how-to guides for dealing with Centrelink and Services Australia: booking appointments, document checklists, call wait times, and when to use myGov vs visit a Service Centre." canonicalPath="/guides/" schema={schema}>
  <Breadcrumbs items={[{label: 'Home', href: '/'}, {label: 'Guides'}]} />

  <article class="page">
    <header class="page-header">
      <p class="eyebrow eyebrow-guide">Guides Hub</p>
      <h1>Practical Centrelink Guides</h1>
      <p class="status-chip">{guides.length} how-to guides</p>
    </header>

    <div class="article-grid-v2">
      <div class="article-main">
        <p class="intro">Dealing with Centrelink and Services Australia can be frustrating — long phone queues, paperwork, and confusing eligibility rules. These guides cut through the noise with practical, step-by-step advice on the most common situations.</p>

        <h2>All guides</h2>
        <ul class="service-list-grid">
          {guides.map(g => (
            <li>
              <a href={`/guides/${g.slug}/`}>
                <strong>{g.h1}</strong>
                <span class="centre-meta">
                  <span class="centre-chip">{g.category}</span>
                </span>
              </a>
            </li>
          ))}
        </ul>
      </div>

      <aside class="sidebar-stack">
        <div class="quick-info-card">
          <h3>Quick access</h3>
          <dl>
            <dt>Centrelink</dt>
            <dd><a href={`tel:${site.centrelink_phone.replace(/\s+/g, '')}`}>{site.centrelink_phone}</a></dd>
            <dt>myGov</dt>
            <dd><a href="https://my.gov.au" rel="noopener">my.gov.au</a></dd>
            <dt>Interpreter</dt>
            <dd><a href="tel:131450">131 450</a></dd>
          </dl>
        </div>
        <div class="related-card">
          <h3>Service guides</h3>
          <ul>
            <li><a href="/services/centrelink-payments/">All Centrelink payments <i class="fas fa-arrow-right"></i></a></li>
            <li><a href="/services/medicare-services/">Medicare services <i class="fas fa-arrow-right"></i></a></li>
            <li><a href="/services/jobseeker-payment/">JobSeeker Payment <i class="fas fa-arrow-right"></i></a></li>
            <li><a href="/services/age-pension-application/">Age Pension <i class="fas fa-arrow-right"></i></a></li>
          </ul>
        </div>
      </aside>
    </div>
  </article>
</Base>

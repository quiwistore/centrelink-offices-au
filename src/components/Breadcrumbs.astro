---
import { site } from '../data/datos.js';
const { items = [], ld = false } = Astro.props;
// ld: emite el schema BreadcrumbList (para paginas que no lo traen en su propio schema)
const path = Astro.url.pathname;
const bl = { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: items.map((it, i) => ({ '@type': 'ListItem', position: i + 1, name: it.label, item: `https://${site.domain}${it.href || path}` })) };
// items: [{ label: "Home", href: "/" }, { label: "Consulado", href: "/consulado/" }, { label: "Dirección" }]
---

<nav class="breadcrumbs" aria-label="Breadcrumb">
  <ol>
    {items.map((item, i) => (
      <li>
        {item.href ? (
          <a href={item.href}>{item.label}</a>
        ) : (
          <span aria-current="page">{item.label}</span>
        )}
        {i < items.length - 1 && <span class="sep" aria-hidden="true">/</span>}
      </li>
    ))}
  </ol>
</nav>
{ld && <script type="application/ld+json" set:html={JSON.stringify(bl)} />}
